# Variáveis do hPanel (Node.js → Environment variables). Valem para build e
# runtime, e persistem entre deploys — não precisam ser reaplicadas a cada push.

# URL pública do site. No domínio temporário, deixar como está abaixo (o
# fallback em lib/site.ts já aponta para o mesmo valor). Na virada, trocar
# para https://kanakcolchoes.com.br.
NEXT_PUBLIC_SITE_URL=https://beige-octopus-880165.hostingersite.com

# REST API do WordPress headless (specs/site.md §9). O WordPress de
# kanakcolchoes.com.br é outro site, em produção — não usar aqui.
WORDPRESS_API_URL=https://cms.kanakcolchoes.com.br/wp-json

# Liga indexação por busca (robots + sitemap). Só na virada para o domínio
# final: SITE_INDEXAVEL=1. Sem definir, o site fica noindex.
# SITE_INDEXAVEL=1

# ⏳ PENDENTE (specs/site.md §12): IDs de GA4 e Meta Pixel.
# NEXT_PUBLIC_GA_ID=
# NEXT_PUBLIC_META_PIXEL_ID=
